# OpenClaw / Social Seller — variáveis de ambiente (desenvolvimento)
# COPIE para .env e preencha com valores reais
# NUNCA cometa .env no git

# Repositório do projeto (usado pelo OpenClaw para resolver ${SOCIAL_SELLER_REPO})
SOCIAL_SELLER_REPO=/home/thiago/projetos/ClaudeCode/social-seller-edson-openclaw

# Meta / Instagram
IG_ACCESS_TOKEN=YOUR_IG_ACCESS_TOKEN_HERE
IG_USER_ID=YOUR_IG_USER_ID_HERE
META_APP_SECRET=YOUR_META_APP_SECRET_HERE
META_VERIFY_TOKEN=YOUR_META_VERIFY_TOKEN_HERE

# Telegram (opcional, para alertas de fila humana)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# Modelo (opcional — override do default do gateway)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
